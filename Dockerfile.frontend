FROM node:22-slim AS builder

WORKDIR /app

COPY frontend-ts/package.json frontend-ts/package-lock.json ./
RUN npm ci

COPY frontend-ts .

# Vite only exposes env vars prefixed VITE_ to client code (import.meta.env) — see
# InputForm.tsx's Footer, which reads VITE_GIT_COMMIT_HASH to link the exact commit deployed.
ARG GIT_COMMIT_HASH
ENV VITE_GIT_COMMIT_HASH=$GIT_COMMIT_HASH
RUN npm run build


FROM nginx:alpine

COPY frontend-ts/nginx.conf /etc/nginx/conf.d/default.conf
COPY frontend-ts/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

ENTRYPOINT ["/docker-entrypoint.sh"]
