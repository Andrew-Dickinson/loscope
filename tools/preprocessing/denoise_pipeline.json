{
  "pipeline": [
    {
      "type": "readers.las"
    },
    {
      "type": "filters.expression",
      "expression": "Classification != 7 && Classification != 18 && Z < 2000 && Z > 0"
    },
    {
        "type":"filters.outlier",
        "method":"statistical",
        "mean_k":12,
        "multiplier": 4.0
    },
    {
      "type": "writers.las"
    }
  ]
}
